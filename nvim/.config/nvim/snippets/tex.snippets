snippet lst unnumbered list
    \begin{itemize}
    \item ${1:first item}
    \end{itemize}
snippet dcl \documentclass{}
	\documentclass{${1:class}} ${0}
snippet bt bold font text
    \textbf{${1:to be bold}}
snippet bm bold font math
    \mathbf{${1:to be bold}}
snippet bp bullet points
    \begin{itemize}
        \item ${1:first item}
    \end{itemize}
snippet { cases
    \begin{cases}
    ${1:cases} \\
    \end{cases}
snippet t \text{}
    \text{${1:text}}
snippet hw homework
            \documentclass[a4paper,12pt]{article}
            \usepackage{amsmath}  % For advanced math typesetting
            \usepackage{amsfonts} % For math fonts
            \usepackage{graphicx} % For including images
            \usepackage{geometry} % For adjusting page margins
            \usepackage{soul} % For highlighting text
            \geometry{margin=1cm}
            \renewcommand\thesection{}
            \renewcommand\thesubsection{\arabic{subsection})} % Change numbering to just the number
            \renewcommand\thesubsubsection{\alph{subsubsection})} % Combine subsection number with letter
            \title{${1:subject} Homework Session}
            \author{Ibrahim Al-Zubaidi}
            \date{\today}
            
            \begin{document}
            
            \maketitle
            
            \section{Exercise n\textdegree 1}
            \subsection{}
            \subsubsection{}
            ${2:content}
            \end{document}
snippet lim limit
    \lim_{${1:from} \to ${2:to}} 
snippet fc \frac{}{}
	\frac{${1:top}}{${2:bottom}} ${0}
snippet sr \sqrt{}
        \sqrt{${1:squared}}
snippet eq \equation{}
        \begin{align}
	        ${1:equation}
        \end{align}
snippet => \Rightarrow
        \Rightarrow \quad ${0}
snippet IC8 \IC8
        \\documentclass[14pt,a4paper]{article}
         \usepackage[utf8]{inputenc}
         \usepackage[english]{babel}
         \usepackage[margin = 2cm]{geometry}
         \usepackage{graphicx}
         \usepackage{fancyhdr}
         \usepackage{xcolor}
         \pagestyle{fancy}
         \fancyhf{}
         \rhead{\LaTeX}
         \lhead{left head}
         \rfoot{\thepage}
         \renewcommand{\headrulewidth}{0.4pt}
         \renewcommand{\footrulewidth}{0.4pt}
         
         \newcommand{\doublerule}[1][.4pt]{% <===================================
           \noindent
           \makebox[0pt][l]{\rule[.7ex]{\linewidth}{#1}}%
           \rule[0.3pt]{\linewidth}{#1}\par} % <=================================
         
         
         \begin{document}
         
         \begin{titlepage}
           \begin{center}
           \begin{minipage}{0.15\textwidth}%
             \includegraphics[width=0.8\textwidth]{/home/abe/dl/abes_emblem.png}%
           \end{minipage}\hspace{10pt}
           \begin{minipage}{0.6\textwidth}%
             \raggedleft\bfseries%
             Imperial Central Governance\\
             \doublerule  % <====================================================
             In the Name of Allah the Most Gracious; Most Merciful\\
             Imperial Eighth Council - Al-Bina'\\
           \end{minipage}%
         \end{center}
         \vspace{1cm}
         {\centering
           {\huge\bfseries Imperial Decree \#${1:number}\par}
         }
         \paragraph{Abstract}
         
         - Al-Bina'
           \vfill
         {\centering
           {\large \today\par}
         }
         \end{titlepage}
         \end{document} 


